{
  "scripts": {
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:unit": "node scripts/test-runner.js unit",
    "test:integration": "node scripts/test-runner.js integration", 
    "test:export": "node scripts/test-runner.js export",
    "test:accessibility": "node scripts/test-runner.js accessibility",
    "test:export-watch": "node scripts/test-runner.js export --watch",
    "test:debug": "jest --config jest.config.js --verbose --no-coverage",
    "test:ci": "jest --config jest.config.js --coverage --watchAll=false --ci",
    "test:format-validation": "node scripts/test-runner.js format-validation",
    "test:export-workflow": "node scripts/test-runner.js export-workflow"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1", 
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "ts-jest": "^29.1.2"
  }
}