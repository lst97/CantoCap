{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "types": ["node", "@types/node", "electron"]
  },
  "include": [
    "src/preload/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "src/main/**/*",
    "src/renderer/**/*"
  ]
}