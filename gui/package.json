{
	"name": "cantocap-gui",
	"version": "0.1.0.alpha",
	"description": "CantoCap Desktop GUI - Generate Cantonese subtitles from audio/video files",
	"main": "out/main/index.js",
	"packageManager": "pnpm@8.15.0",
	"scripts": {
		"dev": "electron-vite preview",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"package": "electron-builder",
		"dist": "pnpm run build && electron-builder",
		"dist:win": "pnpm run build && electron-builder --win",
		"dist:mac": "pnpm run build && electron-builder --mac",
		"dist:linux": "pnpm run build && electron-builder --linux",
		"postinstall": "electron-builder install-app-deps",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --ext .ts,.tsx,.js,.jsx --report-unused-disable-directives --max-warnings 0"
	},
	"devDependencies": {
		"@types/node": "^24.1.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@vitejs/plugin-react": "^4.7.0",
		"@tailwindcss/postcss": "^4.1.11",
		"autoprefixer": "^10.4.21",
		"electron": "^37.2.4",
		"electron-builder": "^26.0.19",
		"electron-vite": "^4.0.0",
		"eslint": "^9.31.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^6.0.0-rc.1",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"vite": "^7.0.5"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@mui/material": "^7.2.0",
		"@mui/icons-material": "^7.2.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"zustand": "^5.0.6"
	},
	"author": "CantoCap Team",
	"license": "MIT",
	"build": {
		"appId": "com.cantocap.gui",
		"productName": "CantoCap",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"files": [
			"out",
			"dist"
		],
		"extraResources": [
			{
				"from": "../engine",
				"to": "engine"
			}
		],
		"mac": {
			"icon": "build/icon.icns",
			"category": "public.app-category.productivity"
		},
		"win": {
			"icon": "build/icon.ico"
		},
		"linux": {
			"icon": "build/icon.png"
		}
	}
}
