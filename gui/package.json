{
  "name": "cantocap-gui",
  "version": "0.1.0.alpha",
  "description": "CantoCap Desktop GUI - Generate Cantonese subtitles from audio/video files",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "electron-vite preview",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint . --cache --cache-location .eslintcache --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location .eslintcache --fix --report-unused-disable-directives --max-warnings 0",
    "lint:performance": "time eslint . --cache --cache-location .eslintcache --report-unused-disable-directives --max-warnings 0",
    "fix-unused-vars": "node scripts/fix-unused-vars.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:migration": "jest --testPathPattern=migration-validation",
    "test:performance": "jest --testPathPattern=performance-benchmarks",
    "test:integration": "jest --testPathPattern=integration-validation",
    "test:error-recovery": "jest --testPathPattern=error-recovery",
    "test:phase4": "jest --testPathPattern=\"(migration-validation|performance-benchmarks|integration-validation|error-recovery)\"",
    "test:config-manager": "jest --testPathPattern=\"(configuration-manager|config-error-handler|useConfigurationMigration|useUnifiedConfig|EnhancedWorkspaceConfigContext)\"",
    "test:config-manager:unit": "jest --testPathPattern=\"(services|contexts|hooks|utils).*__tests__.*configuration-manager|config-error-handler|useConfigurationMigration|useUnifiedConfig|EnhancedWorkspaceConfigContext\"",
    "test:config-manager:integration": "jest --testPathPattern=\"integration.*(workspace-config-integration|config-manager-e2e)\"",
    "test:config-manager:coverage": "jest --coverage --testPathPattern=\"(configuration-manager|config-error-handler|useConfigurationMigration|useUnifiedConfig|EnhancedWorkspaceConfigContext)\"",
    "test:workspace-grouping": "node scripts/test-workspace-grouping.js",
    "test:workspace-grouping:unit": "node scripts/test-workspace-grouping.js --unit",
    "test:workspace-grouping:integration": "node scripts/test-workspace-grouping.js --integration",
    "test:workspace-grouping:coverage": "node scripts/test-workspace-grouping.js --coverage",
    "test:workspace-grouping:performance": "node scripts/test-workspace-grouping.js --performance",
    "test:workspace-grouping:accessibility": "node scripts/test-workspace-grouping.js --accessibility",
    "test:workflow-state": "jest --selectProjects workflow-state",
    "test:workflow-state:unit": "jest --testPathPattern=\"workflow-state-manager\\.test\\.ts\"",
    "test:workflow-state:stress": "jest --testPathPattern=\"workflow-state-manager-stress\\.test\\.ts\"",
    "test:workflow-state:e2e": "jest --testPathPattern=\"workflow-state-manager-e2e\\.test\\.ts\"",
    "test:workflow-state:hooks": "jest --testPathPattern=\"useWorkflowStateManager\\.test\\.tsx\"",
    "test:workflow-state:accessibility": "jest --testPathPattern=\"WorkflowStateManager-accessibility\\.test\\.tsx\"",
    "test:workflow-state:performance": "jest --testPathPattern=\"workflow-state-manager-performance\\.test\\.ts\"",
    "test:workflow-state:coverage": "jest --coverage --testPathPattern=\"workflow-state\"",
    "test:workflow-state:all": "jest --testPathPattern=\"workflow-state\" --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@jest/globals": "^30.0.5",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.19",
    "electron-vite": "^4.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.0.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@types/highlight.js": "^10.1.0",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "react": "^19.1.1",
    "react-diff-view": "^3.3.2",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.7"
  },
  "author": "CantoCap Team",
  "license": "MIT",
  "build": {
    "appId": "com.cantocap.gui",
    "productName": "CantoCap",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out",
      "dist"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
